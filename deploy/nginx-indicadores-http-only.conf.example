# FASE 1 — Solo HTTP (emitir certificado Let's Encrypt)
# Copiar a: /etc/nginx/sites-available/indicadores
# NO incluir bloque listen 443 hasta que exista el certificado.
#
#   sudo cp nginx-indicadores-http-only.conf.example /etc/nginx/sites-available/indicadores
#   sudo ln -sf /etc/nginx/sites-available/indicadores /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot certonly --nginx -d indicadores.diresacusco.gob.pe
#
# FASE 2 — Tras certbot OK, reemplazar por nginx-indicadores-ssl.conf.example

server {
    listen 80;
    listen [::]:80;
    server_name indicadores.diresacusco.gob.pe;

    # Convenios (snippet) ANTES del catch-all
    include /etc/nginx/snippets/convenio-proxy.conf;

    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
