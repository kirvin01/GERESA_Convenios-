# FASE 2 — HTTPS (usar SOLO despues de emitir el certificado)
# Requisito previo:
#   sudo ls /etc/letsencrypt/live/indicadores.diresacusco.gob.pe/fullchain.pem
#
#   sudo cp nginx-indicadores-ssl.conf.example /etc/nginx/sites-available/indicadores
#   sudo nginx -t && sudo systemctl reload nginx
# Redireccion HTTP -> HTTPS
server {
    listen 80;
    server_name indicadores.diresacusco.gob.pe;
    return 301 https://$host$request_uri;
}

# HTTPS — intranet (8081) + Convenios (8082 vía snippet)
server {
    listen 443 ssl http2;
    server_name indicadores.diresacusco.gob.pe;

    ssl_certificate     /etc/letsencrypt/live/indicadores.diresacusco.gob.pe/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/indicadores.diresacusco.gob.pe/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Obligar HTTPS en navegadores (HSTS — 1 ano)
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Convenios: /api/, /login, /reportesFED, /assets/ -> 127.0.0.1:8082    include /etc/nginx/snippets/convenio-proxy.conf;

    # Intranet GERESA (resto de rutas)
    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
