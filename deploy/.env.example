# Copie este archivo a deploy/.env en el servidor Ubuntu.
# Contiene las variables para docker compose (servicio api).

# Base de datos SQL Server (red interna del servidor)
DB_HOST=172.16.20.5
DB_PORT=1433
DB_USER=su_usuario
DB_PASSWORD=su_contrasena
DB_DATABASE=DBGERESA
DB_FED=DBFED2026
DB_CG=DBCGESTION_26
