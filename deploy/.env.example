# Copie este archivo a deploy/.env en el servidor Ubuntu (OBLIGATORIO):
#   cp deploy/.env.example deploy/.env
#
# Contiene las variables para docker compose (servicios api y nginx).

# Puerto publico del frontend (nginx). Use 8082 si el puerto 80 ya esta en uso.
NGINX_PORT=8082

# Base de datos SQL Server (red interna del servidor)
DB_HOST=172.16.20.5
DB_PORT=1433
DB_USER=su_usuario
DB_PASSWORD=su_contrasena
DB_DATABASE=DBGERESA
DB_FED=DBFED2026
DB_CG=DBCGESTION_26
DRIVER=ODBC Driver 18 for SQL Server

# JWT
SECRET_KEY=cambiar-por-clave-secreta-larga-y-aleatoria
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS (dominio o IP con puerto de acceso al frontend)
CORS_ORIGINS=http://indicadores.diresacusco.gob.pe,https://indicadores.diresacusco.gob.pe,http://38.210.173.253:8082

# Opcional
APP_TITLE=GERESAPI
APP_VERSION=1.0.0
