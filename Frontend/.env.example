# Copie este archivo a .env y ajuste segun su entorno.
# Tras cambiar valores: npm run build (o reinicie npm run dev)

# --- DEV (Windows 10) ---
# URL del servidor API (sin /api al final)
VITE_API_URL=http://192.168.1.254:8000

# SI = las peticiones van a {VITE_API_URL}/api/... (proxy inverso nginx)
# NO = las peticiones van a {VITE_API_URL}/... (FastAPI directo, puerto 8000)
VITE_CON_PREFIJO=NO

# --- PROD (build antes de desplegar en Ubuntu) ---
# URL base SIN /api al final. Usar HTTPS obligatorio en produccion.
VITE_API_URL=https://indicadores.diresacusco.gob.pe
VITE_CON_PREFIJO=SI
