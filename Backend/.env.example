# Copie este archivo a .env y ajuste segun su entorno.
# Los valores reales NO deben commitearse (Backend/.env esta en .gitignore).

# --- DEV (Windows 10) ---
DB_HOST=192.168.0.3
DB_PORT=1433
DB_USER=su_usuario
DB_PASSWORD=su_contrasena
DB_DATABASE=DBGERESA
DB_FED=DBFED2026
DB_CG=DBCGESTION_26
DRIVER=ODBC Driver 17 for SQL Server

SECRET_KEY=cambiar-por-clave-secreta-larga-y-aleatoria
ACCESS_TOKEN_EXPIRE_MINUTES=60

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.1.254:5173

